# ==========================================
# Server Configuration
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# Database Configuration (PostgreSQL + Prisma)
# ==========================================
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradebackend?schema=public"

# ==========================================
# CoinMarketCap API (For Crypto Price Job)
# ==========================================
# CoinMarketCap Base API URL (e.g. https://pro-api.coinmarketcap.com/v1)
BASE_URL="https://pro-api.coinmarketcap.com/v1"
# Your CoinMarketCap Pro API Key (Required for headers: X-CMC_PRO_API_KEY in priceJob.js)
API_KEY="your_coinmarketcap_api_key_here"

# ==========================================
# Authentication (JWT) - Optional / Planned
# ==========================================
JWT_SECRET="your_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"

